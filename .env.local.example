# ─── API ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/v1

# ─── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Mobile app store links ────────────────────────────────────────────────
# Leave empty until the app is live. While both are empty, every "get the app"
# button/link on the site stays hidden (see lib/config/apps.ts).
# NEXT_PUBLIC_APP_STORE_URL=
# NEXT_PUBLIC_PLAY_STORE_URL=

# ─── Analytics (Phase 2) ──────────────────────────────────────────────────
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_SENTRY_DSN=

# ─── Google Maps API ───────────────────────────────────────────────────
# Browser-side key: restrict by HTTP referrer to this site's domain(s);
# scope to Maps JavaScript API + Places API (New) only.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
